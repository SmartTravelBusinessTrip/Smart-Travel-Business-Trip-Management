# ─────────────────────────────────────────────────────────────────────────────
# .env.e2e.example — Template cấu hình E2E cho Playwright
#
# Sao chép file này thành .env.e2e.local rồi điền giá trị thực tế.
# .env.e2e.local đã được gitignore — KHÔNG commit file chứa credentials thật.
#
# Playwright đọc .env.e2e.local qua: loadEnv({ path: '.env.e2e.local' })
# (xem playwright.config.ts)
#
# Prerequisite: chạy seed đầy đủ trên test DB trước khi chạy E2E
#   npm.cmd --prefix src/backend run db:migrate:prod
#   npm.cmd --prefix src/backend run db:seed
#   npm.cmd --prefix src/backend run db:seed:e2e
# ─────────────────────────────────────────────────────────────────────────────

# ── URL môi trường test ───────────────────────────────────────────────────────
# URL frontend của môi trường test biệt lập (Railway hoặc địa chỉ local)
# Phải là môi trường tách biệt hoàn toàn khỏi production
BASE_URL=https://<your-test-env>.up.railway.app


# ── Database test (chỉ dùng khi chạy db:seed / db:migrate trực tiếp) ─────────
# Không trỏ vào production DB — chỉ dùng cho test DB Railway hoặc Docker local
DATABASE_URL=postgresql://<user>:<password>@<host>.railway.app:<port>/<db>?schema=public


# ─────────────────────────────────────────────────────────────────────────────
# E2E Accounts — tương ứng với seed.ts + seed.e2e.ts
# Tất cả password mặc định: Password123!
# ─────────────────────────────────────────────────────────────────────────────

# Employee 1 — Nguyễn Văn Nam (có nhiều trips: DRAFT, SUBMITTED, ONGOING, CLOSED, APPROVED-3)
# Dùng cho: E2E-01, E2E-02, E2E-03, E2E-05, E2E-06, E2E-11
E2E_EMPLOYEE_EMAIL=nam.nguyen@smarttravel.dev
E2E_EMPLOYEE_PASSWORD=Password123!

# Employee 2 — Trần Thị Bảo (có trips: APPROVED, REJECTED, APPROVED-2)
# Dùng cho: E2E-03, E2E-04, E2E-07, E2E-11
E2E_EMPLOYEE2_EMAIL=bao.tran@smarttravel.dev
E2E_EMPLOYEE2_PASSWORD=Password123!

# Employee không có trip — Đinh Thị Hoa (empty state)
# Dùng cho: E2E-09 (kiểm tra dashboard rỗng)
E2E_EMPLOYEE_EMPTY_EMAIL=hoa.dinh@smarttravel.dev
E2E_EMPLOYEE_EMPTY_PASSWORD=Password123!

# Employee ngoài phạm vi Manager A — Lý Văn Phong (báo cáo lên Manager B)
# Dùng cho: E2E-04 (Manager A không được duyệt trip của Employee này)
E2E_EMPLOYEE_OUT_SCOPE_EMAIL=phong.ly@smarttravel.dev
E2E_EMPLOYEE_OUT_SCOPE_PASSWORD=Password123!

# Manager A — Trần Đình Hùng (quản lý Employee 1 và Employee 2)
# Dùng cho: E2E-03, E2E-04, E2E-05, E2E-07, E2E-09, E2E-10
E2E_MANAGER_EMAIL=hung.tran@smarttravel.dev
E2E_MANAGER_PASSWORD=Password123!

# Manager B — Nguyễn Minh Khoa (quản lý Employee out-of-scope)
# Dùng cho: E2E-04 (kiểm tra Manager B thấy đúng queue của mình)
E2E_MANAGER_B_EMAIL=khoa.nguyen@smarttravel.dev
E2E_MANAGER_B_PASSWORD=Password123!

# Manager không có direct report nào gửi trip — Trần Văn An (empty queue)
# Dùng cho: E2E-09 (kiểm tra dashboard Manager rỗng)
E2E_MANAGER_EMPTY_EMAIL=an.tran@smarttravel.dev
E2E_MANAGER_EMPTY_PASSWORD=Password123!

# Travel Admin — Lê Thị Mai
# Dùng cho: E2E-03, E2E-09, E2E-10
E2E_TRAVEL_ADMIN_EMAIL=mai.le@smarttravel.dev
E2E_TRAVEL_ADMIN_PASSWORD=Password123!

# Finance — Phạm Thu Trang
# Dùng cho: E2E-07, E2E-08, E2E-09, E2E-10, E2E-11
E2E_FINANCE_EMAIL=trang.pham@smarttravel.dev
E2E_FINANCE_PASSWORD=Password123!


# ─────────────────────────────────────────────────────────────────────────────
# Reference IDs — Fixed UUIDs từ seed (dùng trong spec khi cần truy cập trực tiếp)
# ─────────────────────────────────────────────────────────────────────────────

# Trips
E2E_TRIP_DRAFT_ID=11111111-0000-4000-a000-000000000001
E2E_TRIP_SUBMITTED_ID=22222222-0000-4000-a000-000000000002
E2E_TRIP_APPROVED_ID=33333333-0000-4000-a000-000000000003
E2E_TRIP_URGENT_L2_ID=44444444-0000-4000-a000-000000000004
E2E_TRIP_REJECTED_ID=55555555-0000-4000-a000-000000000005
E2E_TRIP_OUT_SCOPE_ID=66666666-0000-4000-a000-000000000006
E2E_TRIP_ONGOING_ID=77777777-0000-4000-a000-000000000007
E2E_TRIP_APPROVED_2_ID=88888888-0000-4000-a000-000000000008
E2E_TRIP_CLOSED_ID=99999999-0000-4000-a000-000000000009
E2E_TRIP_APPROVED_3_ID=aaaaaaaa-0000-4000-a000-000000000010

# Expenses
E2E_EXPENSE_SUBMITTED_ID=ex222222-0000-4000-a000-000000000002
E2E_EXPENSE_VARIANCE_5PCT_ID=ex333333-0000-4000-a000-000000000003
E2E_EXPENSE_REAPPROVE_ID=ex444444-0000-4000-a000-000000000004
E2E_EXPENSE_CLOSED_ID=ex555555-0000-4000-a000-000000000005
